#!/bin/sh

set -eu

DEV_TOOLS_VERSION='0.3.0'
DEV_TOOLS_UPDATE_URL_DEFAULT='https://raw.githubusercontent.com/it-nsk/dev-scripts/dev/bin/dev-tools-global'

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
has() { command -v "$1" >/dev/null 2>&1; }

env_value_from_file()
{
    file=$1
    name=$2
    [ -f "$file" ] || return 1
    value=$(sed -n "s/^${name}=//p" "$file" | tail -n 1)
    [ -n "$value" ] || return 1
    case "$value" in
        \"*\") value=${value#\"}; value=${value%\"} ;;
        \'*\') value=${value#\'}; value=${value%\'} ;;
    esac
    printf '%s\n' "$value"
}

env_value()
{
    name=$1
    value=${2-}
    if candidate=$(env_value_from_file "$PROJECT_DIR/.env" "$name"); then value=$candidate; fi
    if candidate=$(env_value_from_file "$PROJECT_DIR/.env.local" "$name"); then value=$candidate; fi
    eval "override=\${$name-}"
    if [ -n "${override:-}" ]; then value=$override; fi
    printf '%s\n' "$value"
}

require_project()
{
    [ -f "$PROJECT_DIR/.env" ] || fail ".env not found in $PROJECT_DIR"
}

ensure_local_env()
{
    [ -f "$PROJECT_DIR/.env.local" ] && return 0
    [ -f "$PROJECT_DIR/.env.local.example" ] || return 0
    cp "$PROJECT_DIR/.env.local.example" "$PROJECT_DIR/.env.local"
    printf 'Created .env.local from .env.local.example\n'
}

compose()
{
    if [ -f "$PROJECT_DIR/.env.local" ]; then
        docker compose \
            --env-file "$PROJECT_DIR/.env" \
            --env-file "$PROJECT_DIR/.env.local" \
            -f "$PROJECT_DIR/$COMPOSE_FILE" "$@"
    else
        docker compose \
            --env-file "$PROJECT_DIR/.env" \
            -f "$PROJECT_DIR/$COMPOSE_FILE" "$@"
    fi
}

ensure_compose_file()
{
    if [ ! -f "$PROJECT_DIR/$COMPOSE_FILE" ]; then
        [ -f "$PROJECT_DIR/$COMPOSE_EXAMPLE" ] || fail "$COMPOSE_EXAMPLE not found"
        cp "$PROJECT_DIR/$COMPOSE_EXAMPLE" "$PROJECT_DIR/$COMPOSE_FILE"
        printf 'Created %s from %s\n' "$COMPOSE_FILE" "$COMPOSE_EXAMPLE"
    fi
}

check_docker()
{
    has docker || fail 'Docker is not installed'
    docker info >/dev/null 2>&1 || fail 'Docker is not running'
    docker compose version >/dev/null 2>&1 || fail 'Docker Compose plugin is not installed'
}

ensure_proxy()
{
    docker network inspect "$PROXY_NETWORK" >/dev/null 2>&1 \
        || docker network create "$PROXY_NETWORK" >/dev/null
    running=$(docker inspect -f '{{.State.Running}}' "$TRAEFIK_CONTAINER" 2>/dev/null || true)
    connected=$(docker inspect \
        -f "{{if index .NetworkSettings.Networks \"$PROXY_NETWORK\"}}true{{end}}" \
        "$TRAEFIK_CONTAINER" 2>/dev/null || true)
    if [ "$running" = true ] && [ "$connected" = true ]; then
        return
    fi
    if [ ! -d "$TRAEFIK_DIR" ]; then
        has git || fail 'Git is required to install Traefik'
        git clone "$TRAEFIK_REPOSITORY" "$TRAEFIK_DIR"
    fi
    [ -f "$TRAEFIK_DIR/docker-compose.yml" ] \
        || fail "Traefik compose file not found: $TRAEFIK_DIR/docker-compose.yml"
    if [ "$running" = true ]; then
        printf 'Recreating Traefik: network %s is missing\n' "$PROXY_NETWORK"
        docker compose -f "$TRAEFIK_DIR/docker-compose.yml" up -d --force-recreate
    else
        docker compose -f "$TRAEFIK_DIR/docker-compose.yml" up -d
    fi
    running=$(docker inspect -f '{{.State.Running}}' "$TRAEFIK_CONTAINER" 2>/dev/null || true)
    connected=$(docker inspect \
        -f "{{if index .NetworkSettings.Networks \"$PROXY_NETWORK\"}}true{{end}}" \
        "$TRAEFIK_CONTAINER" 2>/dev/null || true)
    [ "$running" = true ] && [ "$connected" = true ] \
        || fail "Traefik is not connected to $PROXY_NETWORK"
}

ensure_certificates()
{
    [ -n "$DOMAINS" ] || return 0
    [ -n "$SSL_CERT" ] || return 0
    [ -n "$SSL_KEY" ] || return 0
    cert="$PROJECT_DIR/$SSL_CERT"
    key="$PROJECT_DIR/$SSL_KEY"
    if [ -f "$cert" ] && openssl x509 -checkend 86400 -noout -in "$cert" >/dev/null 2>&1; then return 0; fi
    has openssl || fail 'OpenSSL is required to generate a local certificate'
    mkdir -p "$(dirname "$cert")"
    primary_domain=${DOMAINS%% *}
    san=''
    for domain in $DOMAINS; do
        if [ -n "$san" ]; then san="$san,"; fi
        san="${san}DNS:${domain}"
    done
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
        -keyout "$key" -out "$cert" -subj "/CN=$primary_domain" \
        -addext "subjectAltName=$san" >/dev/null 2>&1
    printf 'Generated certificate for %s\n' "$DOMAINS"
}

ensure_hosts()
{
    [ -n "$DOMAINS" ] || return 0
    missing=''
    for domain in $DOMAINS; do
        if ! grep -Eq "(^|[[:space:]])${domain}([[:space:]]|$)" /etc/hosts; then
            missing="$missing $domain"
        fi
    done
    [ -n "$missing" ] || return 0
    line="127.0.0.1$missing"
    if [ -w /etc/hosts ]; then
        printf '%s\n' "$line" >>/etc/hosts
    elif has sudo; then
        printf '%s\n' "$line" | sudo tee -a /etc/hosts >/dev/null
    else
        fail "Cannot update /etc/hosts; add:$missing"
    fi
    printf 'Added to /etc/hosts:%s\n' "$missing"
}

dump_download()
{
    [ -n "$DUMP_HOST" ] || fail 'DEV_TOOLS_DUMP_HOST is not configured'
    [ -n "$DUMP_REMOTE_PATH" ] || fail 'DEV_TOOLS_DUMP_REMOTE_PATH is not configured'
    has ssh || fail 'ssh is required'
    has scp || fail 'scp is required'
    has gzip || fail 'gzip is required'
    target="$PROJECT_DIR/$DUMP_FILE"
    [ ! -e "$target" ] || [ -f "$target" ] || fail "$DUMP_FILE exists but is not a file"
    partial="${target}.part"
    rm -f "$partial"
    ssh -o BatchMode=yes -o ConnectTimeout=5 "$DUMP_HOST" exit || fail "Cannot connect to $DUMP_HOST"
    remote=$(ssh "$DUMP_HOST" "ls -t $DUMP_REMOTE_PATH | head -1")
    [ -n "$remote" ] || fail "Dump not found: $DUMP_REMOTE_PATH"
    scp "$DUMP_HOST:$remote" "$partial" || {
        rm -f "$partial"
        fail "Cannot download $remote"
    }
    gzip -t "$partial" || {
        rm -f "$partial"
        fail 'Downloaded dump is not a valid gzip archive'
    }
    mv "$partial" "$target"
    printf 'Downloaded %s\n' "$DUMP_FILE"
}

dump_import()
{
    dump="$PROJECT_DIR/$DUMP_FILE"
    [ -f "$dump" ] || fail "$DUMP_FILE not found; run dev-tools dump:download"
    has gzip || fail 'gzip is required'
    gzip -t "$dump" || fail "$DUMP_FILE is not a valid gzip archive"
    [ "$DB_DRIVER" = mysql ] || fail "Unsupported DEV_TOOLS_DB_DRIVER: $DB_DRIVER"
    [ -n "$DB_NAME" ] || fail 'DEV_TOOLS_DB_NAME is not configured'
    case "$DB_NAME" in *[!A-Za-z0-9_]*) fail 'DEV_TOOLS_DB_NAME contains unsupported characters' ;; esac
    compose exec -T "$DB_SERVICE" mysql \
        "-h$DB_HOST" "-P$DB_PORT" "-u$DB_USER" "--password=$DB_PASSWORD" \
        -e "DROP DATABASE IF EXISTS \`$DB_NAME\`; CREATE DATABASE \`$DB_NAME\`;"
    gzip -cd "$dump" | compose exec -T "$DB_SERVICE" mysql \
        "-h$DB_HOST" "-P$DB_PORT" "-u$DB_USER" "--password=$DB_PASSWORD" "$DB_NAME"
    printf 'Imported %s into %s\n' "$DUMP_FILE" "$DB_NAME"
}

project_exec() { compose exec -T "$APP_SERVICE" "$@"; }

project_shell()
{
    if [ "$#" -eq 0 ]; then
        compose exec \
            -e GIT_CONFIG_COUNT=1 \
            -e GIT_CONFIG_KEY_0=safe.directory \
            -e "GIT_CONFIG_VALUE_0=$PROJECT_CONTAINER_DIR" \
            "$APP_SERVICE" "${SHELL_IN_CONTAINER:-sh}"
        return
    fi
    [ "$#" -eq 1 ] || fail 'Use: dev-tools sh or dev-tools sh "command"'
    compose exec -T \
        -e GIT_CONFIG_COUNT=1 \
        -e GIT_CONFIG_KEY_0=safe.directory \
        -e "GIT_CONFIG_VALUE_0=$PROJECT_CONTAINER_DIR" \
        "$APP_SERVICE" sh -lc "$1"
}

composer_exec()
{
    compose exec -T \
        -e GIT_CONFIG_COUNT=1 \
        -e GIT_CONFIG_KEY_0=safe.directory \
        -e "GIT_CONFIG_VALUE_0=$PROJECT_CONTAINER_DIR" \
        "$APP_SERVICE" composer "$@"
}

check_composer_ssh()
{
    [ -n "$COMPOSER_SSH_HOST" ] || return 0
    project_exec ssh -F /dev/null -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no \
        -T "$COMPOSER_SSH_HOST" >/dev/null 2>&1 \
        || fail "SSH access to $COMPOSER_SSH_HOST is unavailable; run ssh-add on the host"
}

init_project()
{
    check_docker
    ensure_local_env
    ensure_compose_file
    ensure_proxy
    ensure_certificates
    ensure_hosts
    if [ -n "$DUMP_HOST" ] && [ -n "$DUMP_REMOTE_PATH" ] && [ ! -f "$PROJECT_DIR/$DUMP_FILE" ]; then
        dump_download
    fi
    compose up -d --build
    check_composer_ssh
    composer_exec install --no-interaction --no-progress
    if [ -f "$PROJECT_DIR/package.json" ]; then
        if [ -f "$PROJECT_DIR/package-lock.json" ]; then
            project_exec npm ci
        else
            project_exec npm install
        fi
        project_exec npm run build --if-present
    fi
    if compose exec -T "$APP_SERVICE" test -x vendor/bin/dev-tools; then
        host_user="$(id -u):$(id -g)"
        compose exec -T \
            --user "$host_user" \
            -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory \
            -e "GIT_CONFIG_VALUE_0=$PROJECT_CONTAINER_DIR" \
            "$APP_SERVICE" vendor/bin/dev-tools hooks:install --mode=docker
    fi
    if [ -f "$PROJECT_DIR/bin/console" ]; then project_exec php bin/console cache:clear; fi
    printf 'Project initialized. Domains: %s\n' "$DOMAINS"
}

self_update()
{
    has curl || fail 'curl is required for self-update'
    url=${DEV_TOOLS_UPDATE_URL:-$DEV_TOOLS_UPDATE_URL_DEFAULT}
    destination=${DEV_TOOLS_INSTALL_PATH:-$0}
    tmp=$(mktemp "${TMPDIR:-/tmp}/dev-tools.XXXXXX")
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    curl -fsSL "$url" -o "$tmp"
    chmod +x "$tmp"
    new_version=$("$tmp" version 2>/dev/null) || fail 'Downloaded file is not a valid dev-tools binary'
    if [ "$new_version" = "$DEV_TOOLS_VERSION" ]; then
        printf 'dev-tools is already up to date (%s)\n' "$DEV_TOOLS_VERSION"
        return
    fi
    if [ -w "$destination" ] || { [ ! -e "$destination" ] && [ -w "$(dirname "$destination")" ]; }; then
        mv "$tmp" "$destination"
    elif has sudo; then
        sudo install -m 0755 "$tmp" "$destination"
    else
        fail "Cannot replace $destination"
    fi
    trap - EXIT HUP INT TERM
    printf 'Updated dev-tools: %s -> %s\n' "$DEV_TOOLS_VERSION" "$new_version"
}

help()
{
    cat <<'EOF'
dev-tools — shared project bootstrap, Docker and quality commands

Usage:
  dev-tools init
  dev-tools up|down|build|rebuild|logs|ps
  dev-tools sh ["command"]
  dev-tools compose <arguments...>
  dev-tools dump:download|dump:import
  dev-tools cs:check|cs:fix|phpstan|hooks:install
  dev-tools self-update
  dev-tools version
EOF
}

PROJECT_DIR=${DEV_TOOLS_PROJECT_DIR:-$(pwd)}
command=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi
case "$command" in version|--version|-V) printf '%s\n' "$DEV_TOOLS_VERSION"; exit 0 ;; esac
case "$command" in help|--help|-h) help; exit 0 ;; esac
case "$command" in self-update) self_update; exit 0 ;; esac
require_project
ensure_local_env

COMPOSE_FILE=$(env_value DEV_TOOLS_COMPOSE_FILE docker-compose.yml)
COMPOSE_EXAMPLE=$(env_value DEV_TOOLS_COMPOSE_EXAMPLE docker-compose.example.yml)
APP_SERVICE=$(env_value DEV_TOOLS_APP_SERVICE app)
PROJECT_CONTAINER_DIR=$(env_value DEV_TOOLS_PROJECT_CONTAINER_DIR '*')
PROXY_NETWORK=$(env_value DEV_TOOLS_PROXY_NETWORK proxy)
TRAEFIK_CONTAINER=$(env_value DEV_TOOLS_TRAEFIK_CONTAINER traefik)
TRAEFIK_DIR=$(env_value DEV_TOOLS_TRAEFIK_DIR "$(dirname "$PROJECT_DIR")/droxy")
TRAEFIK_REPOSITORY=$(env_value DEV_TOOLS_TRAEFIK_REPOSITORY https://github.com/multifinger/droxy.git)
DOMAIN=$(env_value DEV_TOOLS_DOMAIN '')
PMA_DOMAIN=$(env_value DEV_TOOLS_PMA_DOMAIN '')
DOMAINS=$(env_value DEV_TOOLS_DOMAINS "$DOMAIN $PMA_DOMAIN")
SSL_CERT=$(env_value DEV_TOOLS_SSL_CERT config/ssl/localhost.crt)
SSL_KEY=$(env_value DEV_TOOLS_SSL_KEY config/ssl/localhost.key)
DUMP_HOST=$(env_value DEV_TOOLS_DUMP_HOST '')
DUMP_REMOTE_PATH=$(env_value DEV_TOOLS_DUMP_REMOTE_PATH '')
DUMP_FILE=$(env_value DEV_TOOLS_DUMP_FILE dump.sql.gz)
DB_DRIVER=$(env_value DEV_TOOLS_DB_DRIVER mysql)
DB_SERVICE=$(env_value DEV_TOOLS_DB_SERVICE db)
DB_HOST=$(env_value DEV_TOOLS_DB_HOST localhost)
DB_PORT=$(env_value DEV_TOOLS_DB_PORT 3306)
DB_NAME=$(env_value DEV_TOOLS_DB_NAME '')
DB_USER=$(env_value DEV_TOOLS_DB_USER root)
DB_PASSWORD=$(env_value DEV_TOOLS_DB_PASSWORD root)
COMPOSER_SSH_HOST=$(env_value DEV_TOOLS_COMPOSER_SSH_HOST '')

case "$command" in
    init) init_project ;;
    up) check_docker; ensure_compose_file; ensure_proxy; compose up -d ;;
    down) check_docker; ensure_compose_file; compose down --remove-orphans ;;
    build) check_docker; ensure_compose_file; compose build "$@" ;;
    rebuild) check_docker; ensure_compose_file; compose build "$APP_SERVICE"; compose up -d ;;
    logs) check_docker; ensure_compose_file; compose logs -f "${1:-$APP_SERVICE}" ;;
    sh) check_docker; ensure_compose_file; project_shell "$@" ;;
    ps) check_docker; ensure_compose_file; compose ps ;;
    compose) check_docker; ensure_compose_file; compose "$@" ;;
    dump:download) dump_download ;;
    dump:import) check_docker; ensure_compose_file; dump_import ;;
    cs:check) check_docker; ensure_compose_file; compose exec -T "$APP_SERVICE" vendor/bin/dev-tools cs:check ;;
    cs:fix) check_docker; ensure_compose_file; compose exec -T "$APP_SERVICE" vendor/bin/dev-tools cs:fix ;;
    phpstan) check_docker; ensure_compose_file; compose exec -T "$APP_SERVICE" vendor/bin/dev-tools phpstan "$@" ;;
    hooks:install)
        check_docker
        ensure_compose_file
        host_user="$(id -u):$(id -g)"
        compose exec -T \
            --user "$host_user" \
            -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory \
            -e "GIT_CONFIG_VALUE_0=$PROJECT_CONTAINER_DIR" \
            "$APP_SERVICE" vendor/bin/dev-tools hooks:install --mode=docker
        ;;
    *) fail "Unknown command: $command" ;;
esac
