cs_fixer:
    mode: local
    paths:
        - src
        - config
    exclude:
        - config/secrets

phpstan:
    mode: local
    paths:
        - src
    # Project config is only needed for a baseline or project-specific rules.
    # config: phpstan.dist.neon
    memory_limit: 1G

hooks:
    mode: local

docker:
    service: app
    env_files:
        - .env
        - .env.local
